# --- Printer (from the P1S screen) ---
PRINTER_IP=192.168.1.50
PRINTER_SERIAL=01P00A000000000
ACCESS_CODE=12345678

# --- App ---
# Optional PIN to lock the app. Leave blank for no lock.
APP_PIN=
PORT=8080

# --- Optional phone push alerts via ntfy ---
# Install the "ntfy" app, subscribe to a long random topic, put the same URL here.
# e.g. NTFY_URL=https://ntfy.sh/printwatch-7f3k9q2xv8
NTFY_URL=

# --- Remote access (phone app talks to the Pi directly, HTTPS, paired phones only) ---
REMOTE=on
REMOTE_PORT=8443
# Auto port-forward via your router's UPnP. Set off if you forward TCP 8443 by hand.
UPNP=on
# Only needed if UPnP is off: your home's public IP or hostname
REMOTE_HOST=
